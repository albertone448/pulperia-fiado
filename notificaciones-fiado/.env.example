FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=./firebase-credenciales.json

# Correo (opcional). Si dejás SMTP_HOST vacío, el envío por correo se omite
# y el programa sigue funcionando normal solo con WhatsApp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM="Minisúper El Puente <tu-correo@gmail.com>"

# Recordatorio semanal de saldo pendiente (opcional). Si no ponés estas dos
# líneas, el programa usa sábado (6) a las 4am por defecto.
# Días: domingo=0, lunes=1, martes=2, miércoles=3, jueves=4, viernes=5, sábado=6
RECORDATORIO_DIA_SEMANA=6
RECORDATORIO_HORA=4
